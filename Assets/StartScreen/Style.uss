
/* ==========================================
   SIRVIVE START SCREEN V3
   UNITY 6.3 LTS - UI TOOLKIT
   ========================================== */

.screen-root {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: #0d315a;
    overflow: hidden;
}

/* BACKGROUND */

.factory-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-position: center;
    picking-mode: ignore;
}

/* TOP BAR */

.top-bar {
    height: 94px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 45px;
    padding-right: 45px;
}

.brand-chip {
    height: 46px;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(5, 34, 75, 0.86);
    border-width: 1px;
    border-color: #77a9d5;
    border-radius: 12px;
}

.brand-dot {
    width: 11px;
    height: 11px;
    border-radius: 6px;
    background-color: #fbbf24;
    margin-right: 12px;
}

.brand-chip-text {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
}

.top-settings-button {
    height: 46px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgba(5, 34, 75, 0.86);
    color: #ffffff;
    border-width: 1px;
    border-color: #8abde9;
    border-radius: 11px;
    font-size: 15px;
    -unity-font-style: bold;
}

.top-settings-button:hover {
    background-color: #1458a0;
}

/* HERO */

.hero-layout {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding-left: 35px;
    padding-right: 75px;
    padding-bottom: 20px;
}

.hero-illustration-space {
    width: 52%;
    height: 100%;
    justify-content: flex-end;
}

.hero-bottom-badge {
    align-self: flex-start;
    padding: 13px 20px;
    margin-left: 30px;
    margin-bottom: 12px;
    background-color: rgba(5, 34, 75, 0.86);
    border-left-width: 5px;
    border-left-color: #fbbf24;
    border-radius: 9px;
}

.hero-badge-title {
    color: #fde047;
    font-size: 19px;
    -unity-font-style: bold;
}

.hero-badge-subtitle {
    color: #dbeafe;
    font-size: 13px;
    margin-top: 4px;
}

/* MAIN MENU */

.main-menu {
    width: 48%;
    max-width: 730px;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding-left: 20px;
}

.game-logo-group {
    align-items: center;
    margin-bottom: 34px;
}

.game-eyebrow {
    color: #fde047;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.game-title {
    color: #ffffff;
    font-size: 94px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #06254f;
}

.game-title-line {
    width: 74%;
    height: 6px;
    margin-top: 8px;
    margin-bottom: 15px;
    background-color: #fbbf24;
    border-radius: 4px;
}

.game-subtitle {
    color: #ffffff;
    font-size: 24px;
    -unity-font-style: bold;
}

.game-description {
    color: #dbeafe;
    font-size: 16px;
    margin-top: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.menu-actions {
    width: 100%;
    flex-direction: column;
}

.btn-start {
    height: 92px;
    margin-bottom: 15px;
    background-color: #fbbf24;
    color: #0f172a;
    font-size: 28px;
    -unity-font-style: bold;
    border-width: 3px;
    border-color: #fff0a3;
    border-bottom-width: 7px;
    border-bottom-color: #b45309;
    border-radius: 18px;
}

.btn-start:hover {
    background-color: #fde047;
}

.btn-start:active {
    background-color: #f59e0b;
}

.btn-about {
    height: 64px;
    margin-bottom: 13px;
    background-color: #e8f2ff;
    color: #123a67;
    font-size: 19px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: #b5d6f6;
    border-bottom-width: 5px;
    border-bottom-color: #78a9d6;
    border-radius: 13px;
}

.btn-about:hover {
    background-color: #ffffff;
}

.btn-settings {
    height: 57px;
    background-color: rgba(8, 36, 80, 0.84);
    color: #ffffff;
    font-size: 17px;
    border-width: 1px;
    border-color: #9ac7f0;
    border-radius: 12px;
}

.btn-settings:hover {
    background-color: #1663ae;
}

/* FOOTER */

.bottom-bar {
    width: 100%;
    height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 45px;
    padding-right: 45px;
    background-color: rgba(5, 27, 60, 0.67);
}

.bottom-left-text {
    color: #cbd5e1;
    font-size: 12px;
}

.bottom-right-text {
    color: #fde047;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ==========================================
   MODAL SHARED STYLES
   ========================================== */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: rgba(3, 15, 35, 0.88);
}

.about-modal,
.settings-modal {
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background-color: #f8fafc;
    border-radius: 20px;
    border-width: 2px;
    border-color: #fbbf24;
    overflow: hidden;
}

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    padding: 24px 32px;
    background-color: #103460;
    border-bottom-width: 4px;
    border-bottom-color: #fbbf24;
}

.modal-heading-group {
    flex-grow: 1;
    min-width: 0;
}

.modal-eyebrow {
    color: #fde047;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.modal-title {
    color: #ffffff;
    font-size: 33px;
    -unity-font-style: bold;
}

.modal-subtitle {
    color: #cbd5e1;
    font-size: 15px;
    margin-top: 7px;
    white-space: normal;
}

.btn-modal-close {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    margin-left: 20px;
    background-color: #264970;
    color: #ffffff;
    border-width: 0;
    border-radius: 12px;
    font-size: 30px;
}

.btn-modal-close:hover {
    background-color: #dc2626;
}

/* ==========================================
   ABOUT GAME MODAL
   ========================================== */

.about-modal {
    width: 1080px;
    max-width: 96%;
    height: 84%;
    max-height: 980px;
}

.about-scroll-area {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: #ffffff;
}

.about-scroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.about-intro {
    padding: 32px 40px;
    background-color: #e9f4ff;
    border-bottom-width: 1px;
    border-bottom-color: #cfe1f5;
}

.about-eyebrow {
    color: #b45309;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.about-intro-title {
    color: #0f172a;
    font-size: 27px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 13px;
}

.about-text {
    color: #475569;
    font-size: 17px;
    white-space: normal;
    margin-top: 6px;
}

.about-section {
    padding: 27px 40px;
    border-bottom-width: 1px;
    border-bottom-color: #e2e8f0;
}

.about-section-number {
    color: #2563eb;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.about-section-heading {
    color: #103460;
    font-size: 23px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.about-rule-highlight {
    padding: 22px;
    margin-top: 20px;
    background-color: #fffbeb;
    border-left-width: 5px;
    border-left-color: #fbbf24;
    border-radius: 10px;
}

.about-highlight-tag {
    color: #b45309;
    font-size: 13px;
    -unity-font-style: bold;
}

.about-highlight-heading {
    color: #78350f;
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 6px;
}

/* LEVEL CARDS */

.level-card {
    flex-direction: row;
    align-items: center;
    padding: 20px;
    margin-top: 13px;
    background-color: #f1f5f9;
    border-width: 1px;
    border-color: #dbeafe;
    border-radius: 12px;
}

.level-number {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: 20px;
    background-color: #103460;
    border-radius: 12px;
    color: #ffffff;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-copy {
    flex-grow: 1;
    min-width: 0;
}

.level-title {
    color: #0f172a;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.level-description {
    color: #475569;
    font-size: 16px;
    white-space: normal;
}

.about-end-banner {
    margin: 28px 40px 35px 40px;
    padding: 28px;
    align-items: center;
    background-color: #103460;
    border-radius: 12px;
}

.about-end-title {
    color: #fde047;
    font-size: 26px;
    -unity-font-style: bold;
}

.about-end-description {
    color: #ffffff;
    font-size: 16px;
    margin-top: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* SCROLL BUTTONS */

.about-scroll-controls {
    width: 58px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #eff6ff;
    border-left-width: 1px;
    border-left-color: #dbeafe;
}

.scroll-control-button {
    width: 42px;
    height: 48px;
    margin-top: 7px;
    margin-bottom: 7px;
    background-color: #103460;
    color: #ffffff;
    border-width: 0;
    border-radius: 9px;
    font-size: 20px;
}

.scroll-control-button:hover {
    background-color: #2563eb;
}

.scroll-control-button:disabled {
    opacity: 0.35;
}

/* MODAL FOOTER */

.modal-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 82px;
    padding: 17px 30px;
    background-color: #f8fafc;
    border-top-width: 1px;
    border-top-color: #e2e8f0;
}

.modal-footer-hint {
    color: #64748b;
    font-size: 14px;
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
    margin-right: 16px;
}

.btn-primary {
    height: 52px;
    min-width: 205px;
    padding-left: 23px;
    padding-right: 23px;
    background-color: #fbbf24;
    color: #0f172a;
    border-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: #b45309;
    border-radius: 10px;
    font-size: 16px;
    -unity-font-style: bold;
}

.btn-primary:hover {
    background-color: #fde047;
}

/* ==========================================
   SETTINGS MODAL
   ========================================== */

.settings-modal {
    width: 880px;
    max-width: 96%;
    height: 78%;
    max-height: 830px;
}

.settings-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    background-color: #f8fafc;
}

.settings-section {
    padding: 25px 35px 5px 35px;
}

.settings-section-title {
    color: #2563eb;
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.setting-card {
    padding: 8px 20px;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;
    border-radius: 13px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 93px;
    padding-top: 13px;
    padding-bottom: 13px;
}

.setting-icon-box {
    width: 55px;
    height: 55px;
    flex-shrink: 0;
    margin-right: 18px;
    background-color: #dbeafe;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}

.setting-icon {
    color: #1e40af;
    font-size: 30px;
}

.setting-copy {
    flex-grow: 1;
    min-width: 0;
}

.setting-title {
    color: #0f172a;
    font-size: 20px;
    -unity-font-style: bold;
}

.setting-description {
    color: #64748b;
    font-size: 15px;
    white-space: normal;
    margin-top: 7px;
}

.setting-toggle {
    flex-shrink: 0;
    margin-left: 20px;
}

.setting-divider {
    height: 1px;
    background-color: #e2e8f0;
}

.volume-section {
    padding-top: 22px;
    padding-bottom: 22px;
}

.setting-volume-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.volume-value {
    color: #1d4ed8;
    font-size: 23px;
    -unity-font-style: bold;
}

.volume-slider {
    width: 100%;
    margin-top: 20px;
    margin-bottom: 8px;
}

.volume-scale {
    flex-direction: row;
    justify-content: space-between;
}

.volume-scale-text {
    color: #94a3b8;
    font-size: 13px;
}

.settings-info {
    margin: 22px 35px 25px 35px;
    padding: 18px;
    background-color: #eff6ff;
    border-left-width: 4px;
    border-left-color: #38bdf8;
    border-radius: 10px;
}

.settings-info-text {
    color: #475569;
    font-size: 14px;
    white-space: normal;
}

.settings-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 86px;
    padding: 17px 30px;
    background-color: #ffffff;
    border-top-width: 1px;
    border-top-color: #e2e8f0;
}

.settings-footer-actions {
    flex-direction: row;
    align-items: center;
}

.btn-reset,
.btn-cancel {
    height: 52px;
    min-width: 105px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: #f1f5f9;
    color: #334155;
    border-width: 1px;
    border-color: #cbd5e1;
    border-radius: 10px;
    font-size: 15px;
}

.btn-reset:hover,
.btn-cancel:hover {
    background-color: #e2e8f0;
}

.btn-cancel {
    margin-right: 12px;
}

/* ==========================================
   COMPACT LAYOUT
   ENABLED FROM C#
   ========================================== */

.screen-root.start-compact .top-bar {
    height: 68px;
    padding-left: 20px;
    padding-right: 20px;
}

.screen-root.start-compact .hero-layout {
    padding-left: 10px;
    padding-right: 20px;
}

.screen-root.start-compact .hero-illustration-space {
    width: 43%;
}

.screen-root.start-compact .main-menu {
    width: 57%;
    padding-left: 8px;
}

.screen-root.start-compact .game-logo-group {
    margin-bottom: 18px;
}

.screen-root.start-compact .game-title {
    font-size: 56px;
}

.screen-root.start-compact .game-eyebrow {
    font-size: 11px;
}

.screen-root.start-compact .game-subtitle {
    font-size: 16px;
}

.screen-root.start-compact .game-description {
    font-size: 12px;
}

.screen-root.start-compact .btn-start {
    height: 64px;
    font-size: 20px;
}

.screen-root.start-compact .btn-about {
    height: 47px;
    font-size: 14px;
}

.screen-root.start-compact .btn-settings {
    height: 43px;
    font-size: 13px;
}

.screen-root.start-compact .hero-bottom-badge {
    display: none;
}

.screen-root.start-compact .bottom-bar {
    height: 36px;
    padding-left: 20px;
    padding-right: 20px;
}

.screen-root.start-compact .bottom-left-text,
.screen-root.start-compact .bottom-right-text {
    font-size: 10px;
}

/* Compact modal text */

.screen-root.start-compact .modal-header {
    padding: 15px 23px;
}

.screen-root.start-compact .modal-title {
    font-size: 25px;
}

.screen-root.start-compact .modal-subtitle {
    font-size: 12px;
}

.screen-root.start-compact .about-section {
    padding: 18px 26px;
}

.screen-root.start-compact .about-intro {
    padding: 20px 26px;
}

.screen-root.start-compact .about-section-heading {
    font-size: 19px;
}

.screen-root.start-compact .about-text {
    font-size: 14px;
}

.screen-root.start-compact .level-description {
    font-size: 13px;
}

.screen-root.start-compact .level-card {
    padding: 13px;
}

.screen-root.start-compact .modal-footer {
    min-height: 60px;
    padding: 10px 20px;
}

.screen-root.start-compact .settings-section {
    padding: 13px 22px 3px 22px;
}

.screen-root.start-compact .setting-row {
    min-height: 63px;
}

.screen-root.start-compact .setting-icon-box {
    width: 40px;
    height: 40px;
}

.screen-root.start-compact .setting-title {
    font-size: 16px;
}

.screen-root.start-compact .setting-description {
    font-size: 12px;
}

.screen-root.start-compact .volume-section {
    padding-top: 12px;
    padding-bottom: 12px;
}

.screen-root.start-compact .settings-info {
    margin: 12px 22px;
}

.screen-root.start-compact .settings-footer {
    min-height: 65px;
    padding: 10px 20px;
}

.screen-root.start-compact .btn-primary,
.screen-root.start-compact .btn-reset,
.screen-root.start-compact .btn-cancel {
    height: 43px;
    font-size: 12px;
}
