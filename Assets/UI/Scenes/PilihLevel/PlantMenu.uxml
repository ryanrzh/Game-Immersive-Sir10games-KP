<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
   xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False"
>

    <Style src="../../UniverseUI/index.uss" />
    <Style src="../../style.uss" />

    <!-- Panel Utama Menu Plant -->
    <ui:VisualElement class="flex-col h-full w-full bg-slate-50">
        
        <!-- Header Panel -->
        <ui:VisualElement class="navbar bg-transparent border-0 flex-row justify-between items-center w-full py-10 px-10 min-h-20">
            <ui:VisualElement class="">
                <ui:Button name="btn-back" class="btn btn-ghost flex-row items-center p-2 rounded-lg cursor-pointer px-10 gap-x-5">
                    <ui:VisualElement class="w-6 h-6 icon-back-new tint-slate-900" /> 
                    <ui:Label text="Kembali" class="text-xl text-slate-900 font-bold" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="">
                <ui:Label name="title" text="PILIH LEVEL" class="navbar-title text-slate-900 text-4xl font-extrabold font-plus-jakarta-sans-bold" />
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- Konten Bodi Panel (Tambahkan flex-grow) -->
        <ui:VisualElement class="flex-col items-center justify-center px-5 w-full flex-grow h-full">
            <ui:Label name="lbl-info-plant" text="PLANT RMH" class="text-4xl text-center font-bold font-plus-jakarta-sans-bold"/>
            <ui:VisualElement name="card-container" class="flex-row w-full h-full justify-between flex-grow items-center">
                
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>