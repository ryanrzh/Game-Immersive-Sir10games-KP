
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <Style src="../../UniverseUI/index.uss" />
    <Style src="../../style.uss" />
    <Style src="style.uss" />

    <ui:VisualElement class="leaderboard-root bg-slate-900">

        <!-- NAVIGATION -->
        <ui:VisualElement class="leaderboard-navbar">

            <ui:Button
                name="btn-back"
                text="‹  Kembali"
                class="leaderboard-back" />

            <ui:VisualElement class="leaderboard-title-group">
                <ui:Label
                    text="LEADERBOARD"
                    class="leaderboard-title" />

                <ui:VisualElement class="leaderboard-title-underline" />
            </ui:VisualElement>

            <ui:VisualElement class="leaderboard-navbar-spacer" />

        </ui:VisualElement>

        <ui:VisualElement class="leaderboard-main">

            <!-- FILTER PANEL -->
            <ui:VisualElement class="leaderboard-filters">

                <ui:Label
                    text="Filter Berdasarkan:"
                    class="leaderboard-filter-label" />

                <ui:VisualElement class="leaderboard-filter-inputs">

                    <ui:DropdownField
                        name="dropdown-plant"
                        class="custom-dropdown" />

                    <ui:DropdownField
                        name="dropdown-level"
                        class="custom-dropdown" />

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- MAIN TWO-COLUMN CONTENT -->
            <ui:VisualElement
                name="leaderboard-content"
                class="leaderboard-content">

                <!-- LEFT LEADERBOARD -->
                <ui:VisualElement class="leaderboard-card">

                    <ui:VisualElement class="leaderboard-card-info">

                        <ui:VisualElement class="leaderboard-info-group">
                            <ui:Label
                                text="PERINGKAT PEMAIN"
                                class="leaderboard-info-title" />

                            <ui:Label
                                text="Berdasarkan akumulasi skor"
                                class="leaderboard-info-subtitle" />
                        </ui:VisualElement>

                        <ui:Label
                            name="result-count"
                            text="0 pemain"
                            class="leaderboard-info-count" />

                    </ui:VisualElement>

                    <!-- SCROLL AREA WITH EDGE INDICATORS -->
                    <ui:VisualElement class="leaderboard-scroll-wrapper">

                        <ui:ScrollView
                            name="table-scroll"
                            mode="VerticalAndHorizontal"
                            class="leaderboard-scroll">

                            <ui:VisualElement
                                name="leaderboard-table"
                                class="leaderboard-table">

                                <!-- ALL 8 COLUMNS -->
                                <ui:VisualElement class="leaderboard-table-header">

                                    <ui:Label
                                        text="Peringkat"
                                        class="lb-cell lb-rank lb-header-cell" />

                                    <ui:Label
                                        text="Nama Peserta / NIK"
                                        class="lb-cell lb-name lb-header-cell lb-align-left" />

                                    <ui:Label
                                        text="Jumlah Main"
                                        class="lb-cell lb-play lb-header-cell" />

                                    <ui:Label
                                        text="Total Skor"
                                        class="lb-cell lb-total lb-header-cell" />

                                    <ui:Label
                                        text="Akurasi Rata-rata"
                                        class="lb-cell lb-accuracy lb-header-cell" />

                                    <ui:Label
                                        text="Skor Terbaik"
                                        class="lb-cell lb-best lb-header-cell" />

                                    <ui:Label
                                        text="Rata-rata Skor"
                                        class="lb-cell lb-average lb-header-cell" />

                                    <ui:Label
                                        text="Bintang"
                                        class="lb-cell lb-stars lb-header-cell" />

                                </ui:VisualElement>

                                <ui:VisualElement
                                    name="table-body"
                                    class="leaderboard-table-body" />

                            </ui:VisualElement>

                        </ui:ScrollView>

                        <!-- LEFT FADE -->
                        <ui:VisualElement
                            name="scroll-fade-left"
                            class="scroll-fade scroll-fade-left">

                            <ui:VisualElement class="fade-strip fade-left-strong" />
                            <ui:VisualElement class="fade-strip fade-left-medium" />
                            <ui:VisualElement class="fade-strip fade-left-soft" />

                            <ui:Label
                                name="scroll-arrow-left"
                                text="‹‹"
                                class="scroll-arrow scroll-arrow-left" />

                        </ui:VisualElement>

                        <!-- RIGHT FADE -->
                        <ui:VisualElement
                            name="scroll-fade-right"
                            class="scroll-fade scroll-fade-right">

                            <ui:VisualElement class="fade-strip fade-right-soft" />
                            <ui:VisualElement class="fade-strip fade-right-medium" />
                            <ui:VisualElement class="fade-strip fade-right-strong" />

                            <ui:Label
                                name="scroll-arrow-right"
                                text="››"
                                class="scroll-arrow scroll-arrow-right" />

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- FOOTER -->
                    <ui:VisualElement class="leaderboard-table-footer">

                        <ui:Label
                            text="Geser tabel untuk melihat seluruh statistik"
                            class="leaderboard-footer-hint" />

                        <ui:Label
                            text="TOP 50"
                            class="leaderboard-footer-tag" />

                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- RIGHT SIDEBAR -->
                <ui:VisualElement class="leaderboard-sidebar">

                    <!-- TOP 3 -->
                    <ui:VisualElement class="leaderboard-side-card">

                        <ui:VisualElement class="leaderboard-side-heading">

                            <ui:Label
                                text="TOP 3 PLAYERS"
                                class="leaderboard-side-title" />

                            <ui:Label
                                text="Peringkat terbaik"
                                class="leaderboard-side-subtitle" />

                        </ui:VisualElement>

                        <ui:VisualElement class="top-list">

                            <!-- RANK 1 -->
                            <ui:VisualElement class="top-item top-item-1">

                                <ui:Label
                                    text="#1"
                                    class="top-rank top-rank-1" />

                                <ui:VisualElement class="top-meta">

                                    <ui:Label
                                        name="top1-name"
                                        text="Belum ada pemain"
                                        class="top-name" />

                                    <ui:Label
                                        name="top1-score"
                                        text="—"
                                        class="top-score" />

                                </ui:VisualElement>

                                <ui:Label
                                    name="top1-stars"
                                    text="—"
                                    class="top-stars" />

                            </ui:VisualElement>

                            <!-- RANK 2 -->
                            <ui:VisualElement class="top-item top-item-2">

                                <ui:Label
                                    text="#2"
                                    class="top-rank top-rank-2" />

                                <ui:VisualElement class="top-meta">

                                    <ui:Label
                                        name="top2-name"
                                        text="Belum ada pemain"
                                        class="top-name" />

                                    <ui:Label
                                        name="top2-score"
                                        text="—"
                                        class="top-score" />

                                </ui:VisualElement>

                                <ui:Label
                                    name="top2-stars"
                                    text="—"
                                    class="top-stars" />

                            </ui:VisualElement>

                            <!-- RANK 3 -->
                            <ui:VisualElement class="top-item top-item-3">

                                <ui:Label
                                    text="#3"
                                    class="top-rank top-rank-3" />

                                <ui:VisualElement class="top-meta">

                                    <ui:Label
                                        name="top3-name"
                                        text="Belum ada pemain"
                                        class="top-name" />

                                    <ui:Label
                                        name="top3-score"
                                        text="—"
                                        class="top-score" />

                                </ui:VisualElement>

                                <ui:Label
                                    name="top3-stars"
                                    text="—"
                                    class="top-stars" />

                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- CURRENT PLAYER -->
                    <ui:VisualElement class="leaderboard-me-card">

                        <ui:VisualElement class="leaderboard-me-header">

                            <ui:Label
                                text="POSISI KAMU"
                                class="leaderboard-me-heading" />

                            <ui:Label
                                text="PERSONAL RANK"
                                class="leaderboard-me-tag" />

                        </ui:VisualElement>

                        <ui:VisualElement class="leaderboard-me-content">

                            <ui:Label
                                name="my-rank"
                                text="—"
                                class="leaderboard-me-rank" />

                            <ui:VisualElement class="leaderboard-me-details">

                                <ui:Label
                                    name="my-name"
                                    text="Belum ada data"
                                    class="leaderboard-me-name" />

                                <ui:Label
                                    name="my-score"
                                    text="—"
                                    class="leaderboard-me-score" />

                                <ui:Label
                                    name="my-stars"
                                    text="—"
                                    class="leaderboard-me-stars" />

                            </ui:VisualElement>

                        </ui:VisualElement>

                        <ui:Label
                            name="my-status"
                            text="Berdasarkan kategori yang dipilih"
                            class="leaderboard-me-status" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
