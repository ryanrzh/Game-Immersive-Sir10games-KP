<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../../UniverseUI/index.uss" />
    <Style src="../../../style.uss" />

    <ui:VisualElement class="flex-col w-full h-full bg-slate-100">
        
        <!-- NAVBAR (Sesuai Standar Corporate) -->
        <ui:VisualElement class="navbar bg-slate-800 border-b-4 border-blue-600 flex-row justify-between items-center w-full px-6 py-4 shadow-lg z-20">
            <ui:Label text="Modul 3 | Inspeksi Pekerja" class="text-white text-2xl font-black tracking-wide" />
            
            <ui:VisualElement class="flex-row gap-4 items-center">
                <ui:Button name="btn-hint" text="Gunakan Hint (-5)" class="bg-purple-600 text-white font-bold px-6 py-3 rounded-xl hover:bg-purple-700 border-none cursor-pointer" />
                <ui:Label name="lbl-score" text="Total Skor: 0" class="bg-blue-600 text-white font-bold px-6 py-3 rounded-xl" />
                <ui:Label name="lbl-round" text="Titik 1/3" class="bg-orange-500 text-white font-bold px-6 py-3 rounded-xl" />
                
                <ui:VisualElement class="flex-row items-center gap-3 bg-slate-700 px-5 py-2 rounded-xl">
                    <ui:Button name="btn-info" text="i" class="bg-slate-500 text-white font-black rounded-full w-8 h-8 p-0 border-none hover:bg-slate-600 cursor-pointer" />
                    <ui:VisualElement class="icon-timer w-6 h-6 tint-white" />
                    <ui:Label name="timer-label" text="05:00" class="text-white text-xl font-extrabold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MAIN CONTENT -->
        <ui:VisualElement class="flex-1 flex-row p-6 gap-6">
            
            <!-- PANEL KIRI: Visualisasi Pekerja & Indikator Zona (Callouts) -->
            <ui:VisualElement class="w-[45%] bg-white rounded-3xl shadow-md border border-slate-200 p-6 relative flex-col items-center justify-center overflow-hidden">
                <!-- Judul Panel Kiri -->
                <ui:Label text="VISUALISASI APD TERPASANG" class="text-slate-500 font-extrabold text-sm tracking-widest absolute top-6 left-6" />
                
                <!-- Avatar Pekerja Utama -->
                <ui:VisualElement name="worker-avatar" class="w-[300px] h-[500px] bg-contain bg-center relative mt-8" style="background-image: url('placeholder_avatar.png');" />
                
                <!-- Container untuk Callouts (Label zona yang menunjuk ke tubuh, digenerate oleh C#) -->
                <ui:VisualElement name="callouts-container" class="absolute inset-0 pointer-events-none" />
            </ui:VisualElement>

            <!-- PANEL KANAN: Skenario & Daftar Inspeksi -->
            <ui:VisualElement class="flex-1 flex-col gap-4">
                
                <!-- Kartu Skenario & Bahaya -->
                <ui:VisualElement class="bg-white rounded-2xl shadow-sm border-l-8 border-l-blue-600 p-6">
                    <ui:Label name="lbl-facility-name" text="Nama Area (Titik)" class="text-blue-700 font-black text-xl mb-2 uppercase" />
                    
                    <!-- Skenario Teks -->
                    <ui:Label name="lbl-scenario" text="Deskripsi skenario pekerjaan harian pekerja di area ini." class="text-slate-600 text-sm leading-relaxed whitespace-normal mb-4" />
                    
                    <!-- Wadah Tag Bahaya -->
                    <ui:Label text="Potensi Bahaya Teridentifikasi:" class="text-slate-800 font-bold text-xs mb-2 uppercase" />
                    <ui:VisualElement name="hazard-tags-container" class="flex-row flex-wrap gap-2" />
                </ui:VisualElement>

                <!-- Daftar APD (Scrollable) -->
                <ui:VisualElement class="flex-1 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex-col">
                    <ui:VisualElement class="flex-row justify-between items-end mb-4 border-b-2 border-slate-100 pb-2">
                        <ui:VisualElement class="flex-col">
                            <ui:Label text="DAFTAR APD YANG DIPAKAI PEKERJA" class="text-slate-800 font-black text-lg" />
                            <ui:Label text="Tandai kotak di kanan untuk APD yang TIDAK SESUAI (salah) dengan bahaya." class="text-slate-500 text-sm" />
                        </ui:VisualElement>
                        <ui:Label name="lbl-marked-count" text="0 Ditandai" class="text-red-500 font-bold bg-red-100 px-4 py-2 rounded-lg" />
                    </ui:VisualElement>

                    <!-- Tempat List Inspeksi Dihasilkan oleh C# -->
                    <ui:ScrollView name="inspection-list" class="flex-1" />
                </ui:VisualElement>

                <!-- Tombol Konfirmasi -->
                <ui:Button name="btn-submit" text="Selesai Memeriksa" class="w-full bg-green-600 text-white font-black text-xl py-6 rounded-2xl hover:bg-green-700 border-none transition-colors shadow-lg" />
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- (Sematkan HINT MODAL, INFO MODAL, dan RESULT MODAL seperti pada modul sebelumnya di sini) -->
    <!-- RESULT MODAL -->
    <ui:VisualElement name="result-modal" class="absolute inset-0 bg-slate-900/95 items-center justify-center flex" style="display: none; z-index: 70;">
        <ui:VisualElement class="bg-white rounded-3xl flex-col items-center w-[900px] h-[90%] border-4 border-slate-700 shadow-2xl overflow-hidden">
            
            <!-- Header Evaluasi -->
            <ui:VisualElement class="w-full bg-slate-100 items-center py-6 border-b-2 border-slate-200">
                <ui:Label name="result-title" text="EVALUASI MODUL 3" class="text-2xl font-extrabold text-slate-800 mb-2 tracking-wide" />
                <ui:Label name="stars-label" text="★ ★ ★" class="text-6xl font-black text-orange-400 mb-2 tracking-widest drop-shadow-md" />
                <ui:VisualElement class="flex-row items-baseline gap-3">
                    <ui:Label name="score-pct" text="100%" class="text-5xl font-black text-blue-600" />
                    <ui:Label name="status-label" text="(LULUS)" class="text-2xl font-extrabold text-green-600" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Table Header -->
            <ui:VisualElement class="w-full flex-row bg-slate-700 py-3 px-4 mt-4">
                <ui:Label text="Titik &amp; APD" style="width: 35%; -unity-text-align: middle-left;" class="text-sm font-bold text-white" />
                <ui:Label text="Kondisi Asli" style="width: 20%; -unity-text-align: middle-center;" class="text-sm font-bold text-white" />
                <ui:Label text="Tindakan Anda" style="width: 20%; -unity-text-align: middle-center;" class="text-sm font-bold text-white" />
                <ui:Label text="Poin" style="width: 15%; -unity-text-align: middle-center;" class="text-sm font-bold text-white" />
                <ui:Label text="Status" style="width: 10%; -unity-text-align: middle-center;" class="text-sm font-bold text-white" />
            </ui:VisualElement>

            <!-- List Evaluasi (Diisi oleh C#) -->
            <ui:ScrollView name="detail-list" class="w-full flex-1 bg-white" />

            <!-- Footer & Kalkulasi -->
            <ui:VisualElement class="w-full bg-slate-100 p-5 border-t-2 border-slate-200 flex-col gap-4">
                <ui:VisualElement class="flex-row justify-between items-center bg-white p-4 rounded-xl border border-slate-300">
                    <ui:VisualElement class="flex-col">
                        <ui:Label name="summary-base" text="Total Poin Jawaban: 0" class="text-sm font-bold text-slate-600" />
                        <ui:Label name="summary-bonus" text="Bonus Waktu (Sisa Detik): +0" class="text-sm font-bold text-green-600" />
                    </ui:VisualElement>
                    <ui:Label name="score-final" text="SKOR AKHIR: 0" class="text-2xl font-black text-blue-700" />
                </ui:VisualElement>

                <ui:VisualElement class="flex-row gap-4">
                    <ui:Button name="btn-retry" text="Ulangi Modul" class="flex-1 bg-slate-300 text-slate-800 font-extrabold text-lg py-4 rounded-2xl hover:bg-slate-400 transition-colors cursor-pointer border-none" />
                    <ui:Button name="btn-next" text="Lanjut Modul Berikutnya" class="flex-1 bg-green-600 text-white font-extrabold text-lg py-4 rounded-2xl hover:bg-green-700 transition-colors cursor-pointer border-none" />
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- HINT MODAL -->
    <ui:VisualElement name="hint-modal" class="absolute inset-0 bg-slate-900/80 items-center justify-center flex" style="display: none; z-index: 50;">
        <ui:VisualElement class="bg-white p-6 rounded-3xl flex-col items-center w-[400px] border-4 border-amber-400 shadow-2xl">
            <ui:Label text="Konfirmasi Bantuan" class="text-2xl font-extrabold text-slate-800 mb-2" />
            <ui:Label name="hint-msg" text="Bantuan akan otomatis menandai 1 APD yang salah, namun skor Anda akan dipotong. Lanjutkan?" class="text-sm text-center text-slate-600 mb-6 whitespace-normal leading-relaxed" />
            <ui:VisualElement class="flex-row gap-4 w-full">
                <ui:Button name="btn-hint-cancel" text="Batal" class="flex-1 bg-slate-300 text-slate-800 font-bold py-4 rounded-xl hover:bg-slate-400 transition-colors cursor-pointer border-none" />
                <ui:Button name="btn-hint-confirm" text="Gunakan" class="flex-1 bg-amber-500 text-white font-bold py-4 rounded-xl hover:bg-amber-600 transition-colors cursor-pointer border-none" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- INFO MODAL -->
    <ui:VisualElement name="info-modal" class="absolute inset-0 bg-slate-900/80 items-center justify-center flex" style="display: none; z-index: 60;">
        <ui:VisualElement class="bg-white p-8 rounded-3xl flex-col w-[550px] border-4 border-blue-400 shadow-2xl">
            <ui:Label text="Panduan Modul 3 (Inspeksi)" class="text-2xl font-extrabold text-slate-800 border-b-2 border-slate-200 pb-4 mb-4" />
            <ui:Label text="1. Baca skenario pekerjaan dan perhatikan potensi bahaya yang ada di area tersebut.&#10;2. Evaluasi daftar APD yang sedang dipakai oleh pekerja.&#10;3. Klik 'Tandai Salah' HANYA pada APD yang tidak relevan dengan bahaya, atau jika pekerja lupa memakai APD yang seharusnya.&#10;4. Poin bertambah jika analisa benar, dan berkurang jika salah menganalisa atau menggunakan Hint." class="text-sm text-slate-600 whitespace-normal leading-relaxed mb-8" />
            <ui:Button name="btn-info-ok" text="Mengerti" class="w-full bg-blue-600 text-white font-extrabold text-lg py-5 rounded-2xl hover:bg-blue-700 transition-colors cursor-pointer border-none" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- PPE IMAGE MODAL (DETAIL APD) -->
    <ui:VisualElement name="ppe-modal" class="absolute inset-0 bg-slate-900/90 items-center justify-center flex" style="display: none; z-index: 80;">
        <ui:VisualElement class="bg-white p-8 rounded-3xl flex-col items-center w-[500px] border-4 border-slate-300 shadow-2xl relative">
            <ui:Label text="DETAIL APD" class="text-xl font-extrabold text-slate-800 mb-6 tracking-widest border-b-2 border-slate-200 pb-2 w-full text-center" />
            
            <!-- Area Gambar -->
            <ui:VisualElement name="ppe-modal-img" class="w-[300px] h-[300px] bg-slate-100 rounded-xl mb-6 bg-contain bg-center border border-slate-200" />
            
            <!-- Teks -->
            <ui:Label name="ppe-modal-name" text="Nama APD" class="text-2xl font-black text-slate-900 mb-3 text-center whitespace-normal" />
            <ui:Label name="ppe-modal-desc" text="Deskripsi detail APD akan muncul di sini..." class="text-sm text-slate-600 text-center whitespace-normal leading-relaxed" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>