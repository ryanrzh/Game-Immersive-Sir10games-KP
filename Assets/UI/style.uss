.font-plus-jakarta-sans {
    -unity-font: url('Fonts/PlusJakartaSans-VariableFont_wght.ttf');
    -unity-font-definition: url('Fonts/PlusJakartaSans-VariableFont_wght.ttf');
}

.font-plus-jakarta-sans-bold {
    -unity-font: url('Fonts/PlusJakartaSans-Bold.ttf');
    -unity-font-definition: url('Fonts/PlusJakartaSans-Bold.ttf');
}

.font-orbitron {
    -unity-font: url('Fonts/Orbitron-VariableFont_wght.ttf');
    -unity-font-definition: url('Fonts/Orbitron-VariableFont_wght.ttf');
}

.font-orbitron-bold {
    -unity-font: url('Fonts/Orbitron-Bold.ttf');
    -unity-font-definition: url('Fonts/Orbitron-Bold.ttf');
}

.font-montserrat {
    -unity-font: url('Fonts/Montserrat-VariableFont_wght.ttf');
    -unity-font-definition: url('Fonts/Montserrat-VariableFont_wght.ttf');
}

.font-montserrat-bold{
    -unity-font: url('Fonts/Montserrat-Bold.ttf');
    -unity-font-definition: url('Fonts/Montserrat-Bold.ttf');
}

* {
    -unity-font: url('Fonts/PlusJakartaSans-VariableFont_wght.ttf');
    -unity-font-definition: url('Fonts/PlusJakartaSans-VariableFont_wght.ttf');
}


bg-image{
    background-image: url('../Images/Plant/Picture1.png');
    -unity-background-scale-mode: scale-to-fit;
}

.h-md { height: 448px; }
.h-lg { height: 512px; }
.h-xl { height: 576px; }
.h-2xl { height: 672px; }
.h-3xl { height: 768px; }
.h-4xl { height: 896px; }
.h-5xl { height: 1024px; }
.h-6xl { height: 1152px; }
.h-7xl { height: 1280px; }