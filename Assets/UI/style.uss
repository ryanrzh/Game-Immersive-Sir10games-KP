    -unity-background-scale-mode: scale-to-fit;
}

.icon-back-new
{
    background-image: url('Icons/arrow_back_ios_new_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg');
    -unity-background-scale-mode: scale-to-fit;
}

