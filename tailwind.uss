/* ===== Transform ===== */
.rotate-0 { rotate: 0deg; }
.rotate-1 { rotate: 1deg; }
.neg-rotate-1 { rotate: -1deg; }
.rotate-2 { rotate: 2deg; }
.neg-rotate-2 { rotate: -2deg; }
.rotate-3 { rotate: 3deg; }
.neg-rotate-3 { rotate: -3deg; }
.rotate-6 { rotate: 6deg; }
.neg-rotate-6 { rotate: -6deg; }
.rotate-12 { rotate: 12deg; }
.neg-rotate-12 { rotate: -12deg; }
.rotate-45 { rotate: 45deg; }
.neg-rotate-45 { rotate: -45deg; }
.rotate-90 { rotate: 90deg; }
.neg-rotate-90 { rotate: -90deg; }
.rotate-180 { rotate: 180deg; }
.neg-rotate-180 { rotate: -180deg; }
.scale-0 { scale: 0 0; }
.hover-scale-0:hover { scale: 0 0; }
.active-scale-0:active { scale: 0 0; }
.scale-50 { scale: 0.5 0.5; }
.hover-scale-50:hover { scale: 0.5 0.5; }
.active-scale-50:active { scale: 0.5 0.5; }
